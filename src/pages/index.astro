---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/shared/ProductCard.astro';
import FaqList from '../components/shared/FaqList.astro';
import ClosingCTA from '../components/shared/ClosingCTA.astro';
import HomeHero from '../components/home/HomeHero.astro';
import ProofPoints from '../components/home/ProofPoints.astro';
import IndustryTiles from '../components/home/IndustryTiles.astro';
import StepsBand from '../components/home/StepsBand.astro';
import FounderStrip from '../components/home/FounderStrip.astro';
import { faqs } from '../data/faq';
import '../components/h1-ui/h1.css';

const steps = [
  { title: 'Apply in 5 minutes', body: 'Business and license basics. No hard credit pull.' },
  { title: 'We match lenders', body: 'We pick lenders that fit your license and revenue, and say why.' },
  { title: 'See real numbers', body: 'Total cost, payment and every fee, side by side.' },
  { title: 'You decide', body: 'Sign the one that fits or walk away. No fee either way.' },
];
---
<BaseLayout>
  <HomeHero />
  <ProofPoints />

  <section class="section section--paper home-fin" aria-labelledby="fin-h">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <h2 class="h2" id="fin-h">Four ways to fund a cannabis&nbsp;business</h2>
          <p class="h1-lede">Each one fits a different need. We'll say which.</p>
        </div>
        <div class="section-head__action home-fin__link-d"><a class="link" href="/financing">Compare all four</a></div>
      </div>
      <div class="grid grid--4 swipe">
        <ProductCard product="loc" /><ProductCard product="equipment" /><ProductCard product="term" /><ProductCard product="mca" />
      </div>
      <a class="link home-fin__link-m" href="/financing">Compare all four</a>
    </div>
  </section>

  <section class="section section--white home-ind" aria-labelledby="ind-h">
    <div class="container">
      <div class="section-head">
        <div class="section-head__text">
          <h2 class="h2" id="ind-h">Built for licensed operators</h2>
          <p class="h1-lede">Shops, grows and labs each need different money.</p>
        </div>
      </div>
      <IndustryTiles />
    </div>
  </section>

  <StepsBand steps={steps} action={{ label: 'See how it works', href: '/how-it-works' }} />

  <FounderStrip />

  <section class="section section--paper" aria-labelledby="faq-h">
    <div class="container faq-split home-faq">
      <div class="faq-split__head">
        <h2 class="h2" id="faq-h">Straight answers, up&nbsp;front</h2>
        <p class="h1-lede">The questions every operator asks before applying.</p>
        <a href="/faq" class="btn btn--secondary home-faq__btn-d">Read the FAQ</a>
      </div>
      <div>
        <FaqList id="home-faq" items={faqs.home} />
        <a href="/faq" class="btn btn--secondary btn--block home-faq__btn-m">Read the FAQ</a>
      </div>
    </div>
  </section>

  <ClosingCTA title="Find out what you qualify for in 5 minutes." lede="No obligation. Stop anytime, no fee owed." />
</BaseLayout>

<style>
  .home-fin__link-d { display: none; }
  .home-fin .h2 { text-wrap: wrap; }
  .home-fin__link-m { display: inline-block; margin-top: 32px; }
  .home-fin :global(.section-head) { margin-bottom: 32px; }
  .home-ind :global(.section-head) { margin-bottom: 24px; }
  .home-faq__btn-m { margin-top: 32px; }
  .home-faq__btn-d { display: none; }
  .home-faq :global(.faq-split__head) { gap: 12px; }
  @media (min-width: 1024px) {
    .home-fin__link-d { display: block; }
    .home-fin :global(.section-head) { grid-template-columns: minmax(0, 720px) auto; justify-content: start; column-gap: 45px; }
    .home-fin__link-m { display: none; }
    .home-fin :global(.section-head), .home-ind :global(.section-head) { margin-bottom: 48px; }
    .home-fin :global(.section-head__text), .home-ind :global(.section-head__text) { gap: 16px; }
    .home-faq__btn-d { display: inline-flex; margin-top: 24px; }
    .home-faq__btn-m { display: none; }
    .home-faq :global(.faq-split__head) { gap: 16px; }
    .home-faq .h2 { max-width: 380px; }
  }
</style>
