---
// 404: "This page doesn't exist", three ways out, site search, and the four financing products.
// Search hands the words to Google, limited to leverupliquidity.com (the site has no search of its own).
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/shared/Img.astro';
import Icon from '../components/shared/Icon.astro';
import { products } from '../data/products';
import { site } from '../data/site';
import photo from '../assets/images/25-photo-grow-benz-4x3.jpg';

const host = new URL(site.url).host;
---
<BaseLayout metaKey="/404">
  <section class="nf" aria-labelledby="nf-h1">
    <div class="nf__media">
      <Img src={photo} alt="" widths={[400, 800, 1100]} sizes="(min-width: 1440px) 515px, (min-width: 1024px) 36vw, 100vw" priority />
    </div>
    <div class="container nf__grid">
      <div class="nf__text">
        <p class="eyebrow">404</p>
        <h1 class="h1 h1--48" id="nf-h1">This page doesn't exist</h1>
        <p class="lede nf__lede">But your options do.</p>
        <div class="btn-row btn-row--stack nf__btns" data-hero-cta>
          <a href="/" class="btn btn--primary">Go home</a>
          <a href="/financing" class="btn btn--secondary">Compare financing</a>
          <a href="/contact" class="btn btn--secondary">Talk with us</a>
        </div>
        <form class="nf__search" role="search" action="https://www.google.com/search" method="get">
          <label for="nf-q" class="visually-hidden">Search the site</label>
          <Icon name="search" size={20} class="nf__search-icon" />
          <input class="input" type="search" id="nf-q" name="q" placeholder="Search the site" autocomplete="off" enterkeyhint="search" />
          <input type="hidden" name="as_sitesearch" value={host} />
        </form>
      </div>
      <div class="nf__media nf__media--desktop" aria-hidden="true">
        <Img src={photo} alt="" widths={[600, 1100]} sizes="(min-width: 1440px) 515px, 36vw" />
      </div>
    </div>
  </section>

  <section class="quick" aria-labelledby="quick-h">
    <div class="container">
      <h2 class="quick__h" id="quick-h">Financing options</h2>
      <ul class="quick__list" role="list">
        {products.map((p) => (
          <li class="quick__item">
            <span class="quick__thumb"><Img src={p.image} alt="" widths={[112]} sizes="56px" /></span>
            <span class="quick__text">
              <span class="quick__name">{p.name}</span>
              <a href={p.href} class="link">See costs and terms<span class="visually-hidden">: {p.name}</span></a>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { background: var(--bg-canvas); padding-bottom: 40px; }
  .nf__media { aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-brand-deep); }
  .nf__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .nf__media--desktop { display: none; }
  .nf__grid { display: grid; }
  .nf__text { padding-top: 32px; display: grid; justify-items: start; }
  .nf__text .h1 { margin-top: 12px; text-wrap: wrap; }
  /* Phones: lede is IBM Plex Sans 17/28 in the design. */
  .nf__lede { margin-top: 12px; font-family: var(--font-sans); font-size: 17px; line-height: 28px; }
  .nf__btns { margin-top: 24px; width: 100%; gap: 12px; }
  .nf__search { position: relative; margin-top: 24px; width: 100%; }
  .nf__search :global(.nf__search-icon) { position: absolute; left: 20px; top: 50%; transform: translateY(-50%); color: var(--text-secondary); pointer-events: none; }
  .nf__search .input { padding-left: 52px; }
  .nf__search .input::-webkit-search-cancel-button { cursor: pointer; }

  .quick { background: var(--bg-surface); padding-block: 48px 48px; }
  .quick__h { font-family: var(--font-serif); font-size: 28px; line-height: 36px; font-weight: 600; color: var(--text-heading); }
  .quick__list { margin-top: 16px; display: grid; border-top: 1px solid var(--border-default); }
  .quick__item { display: flex; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--border-default); }
  .quick__thumb { width: 56px; height: 56px; flex: none; overflow: hidden; border-radius: var(--radius-sm); background: var(--bg-sunken); }
  .quick__thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .quick__text { display: grid; gap: 2px; }
  .quick__name { font-size: 17px; line-height: 28px; font-weight: 600; color: var(--text-heading); }
  .quick .link { font-size: 15px; line-height: 24px; }

  @media (min-width: 768px) {
    .nf { padding-bottom: 64px; }
    .nf__btns { width: auto; gap: 16px; }
    .quick__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 32px; }
  }
  @media (min-width: 1024px) {
    .nf { padding-block: 96px; }
    .nf > .nf__media { display: none; }
    .nf__media--desktop { display: block; border-radius: var(--radius); }
    .nf__grid { grid-template-columns: minmax(0, 624px) minmax(0, 515px); justify-content: space-between; align-items: center; column-gap: 48px; }
    .nf__text { padding-top: 0; }
    .nf__text .h1 { margin-top: 16px; }
    .nf__lede { margin-top: 16px; font-family: var(--font-serif); font-size: 21.78px; line-height: 32px; }
    .nf__btns { margin-top: 24px; }
    .nf__btns .btn { font-size: 13px; }
    .quick { padding-block: 96px; }
    .quick__h { font-size: 28px; }
    .quick__list { margin-top: 32px; border: 0; row-gap: 24px; }
    .quick__item { padding: 0; border: 0; }
  }
  @media (min-width: 1280px) {
    .quick__list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
