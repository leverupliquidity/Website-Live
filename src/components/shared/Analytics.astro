---
// Umami · Microsoft Clarity. Each loads only when its ID is set in src/data/site.ts.
// The Google tag (GA4, G-E4XKFJR8N3) is pasted directly after <head> in src/layouts/BaseLayout.astro.
// Netlify Analytics/Observability run on Netlify's servers and need no code.
import { integrations } from '../../data/site';
const { umamiWebsiteId, umamiSrc, clarity } = integrations;
---
{umamiWebsiteId && <script is:inline defer src={umamiSrc} data-website-id={umamiWebsiteId}></script>}
{clarity && (
  <script is:inline define:vars={{ clarity }}>
    // Queue calls now; fetch the Clarity tag only after the page has loaded so it never competes with first paint.
    window.clarity = window.clarity || function(){(window.clarity.q=window.clarity.q||[]).push(arguments)};
    function loadClarity(){
      var t=document.createElement("script");t.async=1;t.src="https://www.clarity.ms/tag/"+clarity;
      document.head.appendChild(t);
    }
    if (document.readyState === "complete") loadClarity();
    else window.addEventListener("load", function(){ setTimeout(loadClarity, 0); }, { once: true });
  </script>
)}
<script>import '../../scripts/track';</script>
