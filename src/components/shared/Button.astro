---
// Button / link-button. variant: primary | secondary | primary-on-brand | secondary-on-brand
interface Props {
  href?: string; variant?: 'primary' | 'secondary' | 'primary-on-brand' | 'secondary-on-brand';
  type?: 'button' | 'submit'; block?: boolean; class?: string; track?: string; external?: boolean; [key: string]: any;
}
const { href, variant = 'primary', type = 'button', block = false, class: cls = '', track, external = false, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, block && 'btn--block', cls].filter(Boolean).join(' ');
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
{href
  ? <a href={href} class={classes} data-track={track} {...ext} {...rest}><slot /></a>
  : <button type={type} class={classes} data-track={track} {...rest}><slot /></button>}
